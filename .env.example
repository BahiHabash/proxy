# SOCKS5 proxy configuration.
# Copy this file to `.env` and fill in real credentials.

# Required authentication credentials.
PROXY_USER=myuser
PROXY_PASS=a-very-strong-passphrase-here

# Bind address and port.
PROXY_HOST=0.0.0.0
PROXY_PORT=1080

# Idle socket timeout in seconds.
# Increase this for long-lived streams that are quiet for long periods.
IDLE_TIMEOUT_SECS=600

# Timeout for opening the upstream TCP connection.
UPSTREAM_CONNECTION_TIMEOUT_SEC=30

# Relay engine settings.
RELAY_BUFFER_BYTES=16384
RELAY_WRITE_TIMEOUT_SECS=60

# Maximum concurrently active client sessions.
MAX_CONNECTIONS=1024

# Destination safety.
# Keep false in production unless you intentionally want clients to reach
# private, loopback, or link-local networks from the proxy host.
ALLOW_PRIVATE_DESTINATIONS=false

# Timeouts for unauthenticated/protocol setup phases.
PROTOCOL_DETECTION_TIMEOUT_SECS=5
SOCKS5_HANDSHAKE_TIMEOUT_SECS=10
HTTP_HEADER_TIMEOUT_SECS=10
SHUTDOWN_TIMEOUT_SECS=30

# Accept-loop protection when the OS temporarily refuses new sockets.
ACCEPT_ERROR_BACKOFF_MS=250
ACCEPT_ERROR_LOG_INTERVAL_SECS=5

# Tracing filter and format.
RUST_LOG=info
LOG_FORMAT=pretty

# Logging output. Stdout is preferred for systemd/Docker log management.
# File logging is opt-in, size-bounded, and reset after one day.
LOG_TO_STDOUT=true
LOG_TO_FILE=false
LOG_DIR=logs
LOG_MAX_FILE_BYTES=10485760
LOG_MAX_FILES=5
